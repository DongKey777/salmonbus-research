{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "route-report.schema.json",
  "title": "Per-route DEV evaluation report (route-report/1)",
  "description": "Web receiver contract for public/route-report.json. Verified by src/route-report/contract.ts with closure checks beyond JSON Schema. Route identities are opaque tokens; raw route IDs, route versions, vehicle IDs and plates must not appear.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "origin",
    "runId",
    "evaluationRole",
    "producerStatus",
    "receiptSha256",
    "dataset",
    "routeMap",
    "routes",
    "unknown",
    "models",
    "DEVReused",
    "HRead",
    "modelAdoption",
    "generalizationClaim",
    "replacesGlobalGate",
    "servedAt",
    "sourceReportedAt"
  ],
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^(?=.*[a-f])[0-9a-f]{12,32}$"
    },
    "pairedScore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "MAE",
        "MSE",
        "pairedMAEDelta",
        "pairedMSEDelta"
      ],
      "properties": {
        "MAE": {
          "type": "number",
          "minimum": 0
        },
        "MSE": {
          "type": "number",
          "minimum": 0
        },
        "pairedMAEDelta": {
          "type": [
            "number",
            "null"
          ]
        },
        "pairedMSEDelta": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "nullablePairedScore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "MAE",
        "MSE",
        "pairedMAEDelta",
        "pairedMSEDelta"
      ],
      "properties": {
        "MAE": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "MSE": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "pairedMAEDelta": {
          "type": [
            "number",
            "null"
          ]
        },
        "pairedMSEDelta": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    }
  },
  "properties": {
    "schema": {
      "const": "route-report/1"
    },
    "origin": {
      "const": "REAL_OBSERVATION_PIPELINE"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "evaluationRole": {
      "const": "DEV"
    },
    "producerStatus": {
      "const": "ROUTE_REPORT_DEV_REUSED_NOT_ADOPTED"
    },
    "receiptSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestSha256",
        "trainRows",
        "devRows",
        "trainGroups",
        "devGroups"
      ],
      "properties": {
        "manifestSha256": {
          "const": "a2e42ab6ab45c1f33c8963b13456fe957a500f1752c9d027f4125a0cb0cc7a62"
        },
        "trainRows": {
          "const": 38651044
        },
        "devRows": {
          "const": 20989927
        },
        "trainGroups": {
          "const": 631972
        },
        "devGroups": {
          "const": 351831
        }
      }
    },
    "routeMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "routeDefinition",
        "tokenKind",
        "knownRouteCount",
        "unknownGroupCount"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "routeDefinition": {
          "const": "R.route_id"
        },
        "tokenKind": {
          "const": "OPAQUE_ROUTE_TOKEN"
        },
        "knownRouteCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 96
        },
        "unknownGroupCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 351831
        }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 96,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "token",
          "devRows",
          "devGroups",
          "weightSum",
          "trainSupport"
        ],
        "properties": {
          "token": {
            "$ref": "#/$defs/token"
          },
          "devRows": {
            "type": "integer",
            "minimum": 1
          },
          "devGroups": {
            "type": "integer",
            "minimum": 1
          },
          "weightSum": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "trainSupport": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "rows",
              "groups"
            ],
            "properties": {
              "rows": {
                "type": "integer",
                "minimum": 1
              },
              "groups": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "devRows",
        "devGroups",
        "weightSum"
      ],
      "properties": {
        "devRows": {
          "type": "integer",
          "minimum": 0
        },
        "devGroups": {
          "type": "integer",
          "minimum": 0
        },
        "weightSum": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "trainingMode",
          "depth",
          "rounds",
          "publishedGlobal",
          "micro",
          "knownRouteMacro",
          "unknown",
          "routes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,31}$"
          },
          "role": {
            "enum": [
              "REFERENCE",
              "CANDIDATE"
            ]
          },
          "trainingMode": {
            "enum": [
              "CONTINUED_REFERENCE",
              "FRESH_FROM_ZERO"
            ]
          },
          "depth": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 64
          },
          "rounds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "publishedGlobal": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "source",
              "MAE",
              "MSE"
            ],
            "properties": {
              "source": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,119}\\.json$"
              },
              "MAE": {
                "type": "number",
                "minimum": 0
              },
              "MSE": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "micro": {
            "$ref": "#/$defs/pairedScore"
          },
          "knownRouteMacro": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "MAE",
              "MSE",
              "routeCount"
            ],
            "properties": {
              "MAE": {
                "type": "number",
                "minimum": 0
              },
              "MSE": {
                "type": "number",
                "minimum": 0
              },
              "routeCount": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "unknown": {
            "$ref": "#/$defs/nullablePairedScore"
          },
          "routes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "token",
                "MAE",
                "MSE",
                "pairedMAEDelta",
                "pairedMSEDelta"
              ],
              "properties": {
                "token": {
                  "$ref": "#/$defs/token"
                },
                "MAE": {
                  "type": "number",
                  "minimum": 0
                },
                "MSE": {
                  "type": "number",
                  "minimum": 0
                },
                "pairedMAEDelta": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "pairedMSEDelta": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "DEVReused": {
      "const": true
    },
    "HRead": {
      "description": "false means no holdout split existed when this report was produced; it does not mean the H days were excluded. H = service days 2026-10-13/15/18/19 (split code 2 of DEV) was designated on 2026-10-22. This report was produced before that and scored all DEV (devRows 20,989,927), including the days now designated as H.",
      "const": false
    },
    "modelAdoption": {
      "const": false
    },
    "generalizationClaim": {
      "const": false
    },
    "replacesGlobalGate": {
      "const": false
    },
    "servedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceReportedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "x-semanticRules": [
    "Weights keep the training definition w_q = 1/m_g per arrival group. For a route r: W_r = sum w_q, MAE_r = sum w|e| / W_r, MSE_r = sum w e^2 / W_r. With a complete DEV pass W_r equals devGroups within 1e-6 relative tolerance.",
    "Closure: sum(routes.devRows)+unknown.devRows == 20989927; sum(routes.devGroups)+unknown.devGroups == 351831; sum(routes.weightSum)+unknown.weightSum == 351831 within 1e-6 relative. sum(trainSupport.groups) <= 631972 and sum(trainSupport.rows) <= 38651044.",
    "routes[] carries population facts once; models[].routes carries per-model scores in the same token order. routeMap.knownRouteCount == routes.length; routeMap.unknownGroupCount == unknown.devGroups.",
    "Exactly one model has role REFERENCE and all its paired deltas are null. Every CANDIDATE pairedMAEDelta/pairedMSEDelta equals candidate minus reference for the same route/unknown/micro within 1e-9 relative tolerance (negative = better).",
    "micro.MAE == (sum MAE_r*W_r + MAE_unknown*W_unknown)/(sum W_r + W_unknown) within 1e-9 relative; this is the existing global group-micro definition. knownRouteMacro is the arithmetic mean over known routes only, routeCount == routes.length.",
    "models[].unknown.MAE/MSE are null iff unknown.devGroups == 0. Unknown logical-route mass stays inside micro and is reported separately; it is never dropped or turned into a synthetic route.",
    "publishedGlobal, when present, names the already published global score file (e.g. full-learning-batch.json) and must equal micro within 1e-9 relative; a mismatch rejects the report instead of being displayed as matching.",
    "trainSupport null marks a DEV-only route (no TRAIN groups). Small routes are listed with their support; no fixed group count is declared as statistical sufficiency.",
    "Tokens are opaque (12-32 lowercase hex containing at least one letter). Raw route IDs, route_version_id, vehicle IDs and plates must not appear anywhere in this file.",
    "DEV reused; produced before H was designated on 2026-10-22; devRows include the days now designated as H; no adoption, no generalization claim, and this report never replaces the existing global gate or retroactively modifies published global scores.",
    "Limits: at most 96 routes and at most 8 models so that the worst-case pretty-printed file stays under the 256 KiB transport limit; the byte limit is what the receiver enforces first. servedAt must not be more than 10 minutes ahead of the receiver clock; a future-dated file is rejected."
  ]
}
