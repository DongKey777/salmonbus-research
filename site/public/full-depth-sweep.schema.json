{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "full-depth-sweep.schema.json",
  "title": "Fresh seat depth sweep public projection v2 (SEAT_DEPTH_SWEEP_002)",
  "description": "Web receiver contract for public/full-depth-sweep.json. Verified by src/full-depth-sweep/contract.ts. Supersedes seat-depth-progress-v1 PUBLIC.schema.json (full-depth-sweep/1, runId SEAT_DEPTH_SWEEP_001) which was never published.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "origin",
    "runId",
    "producerStatus",
    "priorAttempt",
    "receiptSha256",
    "completeSha256",
    "phase",
    "terminal",
    "statusDetail",
    "candidate",
    "trainingCallsReserved",
    "verifiedCandidateCount",
    "currentModelRoundsCompleted",
    "trainRows",
    "devRows",
    "baselineRounds",
    "models",
    "bestObservedDevModel",
    "workerElapsedSeconds",
    "servedAt",
    "sourceReportedAt",
    "legacyRunAccepted",
    "modelAdoption",
    "generalizationClaim",
    "DEVReused",
    "productComparison",
    "freshRoundsCompleted",
    "devRowsProcessed",
    "pureDepthContrast",
    "continuedBaselineIsNotFreshControl"
  ],
  "properties": {
    "schema": {
      "const": "full-depth-sweep/2"
    },
    "origin": {
      "const": "REAL_OBSERVATION_PIPELINE"
    },
    "runId": {
      "const": "SEAT_DEPTH_SWEEP_002"
    },
    "producerStatus": {
      "enum": [
        "FRESH_DEPTH_SWEEP_AND_DEV_VERIFIED_NOT_ADOPTED",
        "FAILED_PRESERVED_NOT_ACCEPTED",
        null
      ]
    },
    "priorAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "outcome",
        "freshFits",
        "accepted",
        "publicScorePublished"
      ],
      "properties": {
        "runId": {
          "const": "SEAT_DEPTH_SWEEP_001"
        },
        "outcome": {
          "const": "STOPPED_BEFORE_TRAINING"
        },
        "freshFits": {
          "const": 0
        },
        "accepted": {
          "const": false
        },
        "publicScorePublished": {
          "const": false
        }
      }
    },
    "receiptSha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "completeSha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "phase": {
      "enum": [
        "WAITING",
        "BUILDING_MATRIX",
        "TRAINING",
        "EVALUATING",
        "COMPLETE",
        "FAILED"
      ]
    },
    "terminal": {
      "type": "boolean"
    },
    "statusDetail": {
      "type": "string",
      "maxLength": 1000
    },
    "candidate": {
      "enum": [
        "D4",
        "D6",
        "D8",
        null
      ]
    },
    "trainingCallsReserved": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 3
    },
    "verifiedCandidateCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "currentModelRoundsCompleted": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 256
    },
    "trainRows": {
      "const": 38651044
    },
    "devRows": {
      "const": 20989927
    },
    "baselineRounds": {
      "const": 256
    },
    "models": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "targetRounds",
          "observedRounds",
          "status",
          "metrics",
          "gatePassed",
          "depth",
          "trainingMode"
        ],
        "properties": {
          "id": {
            "enum": [
              "BASELINE",
              "D4",
              "D6",
              "D8"
            ]
          },
          "targetRounds": {
            "const": 256
          },
          "observedRounds": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 256
          },
          "status": {
            "enum": [
              "VALIDATED_SAVED_REFERENCE",
              "NOT_OBSERVED",
              "TRAINING",
              "EVALUATING",
              "BUILDING_MATRIX",
              "FINALIZING",
              "COMPLETE",
              "VERIFIED",
              "TRAINED_NOT_EVALUATED",
              "PROGRESS_OBSERVED"
            ]
          },
          "metrics": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "MAE",
              "MSE",
              "RMSE",
              "Brier",
              "logLoss",
              "NRPS"
            ],
            "properties": {
              "MAE": {
                "type": "number",
                "minimum": 0
              },
              "MSE": {
                "type": "number",
                "minimum": 0
              },
              "RMSE": {
                "type": "number",
                "minimum": 0
              },
              "Brier": {
                "type": "null"
              },
              "logLoss": {
                "type": "null"
              },
              "NRPS": {
                "type": "null"
              }
            }
          },
          "gatePassed": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "depth": {
            "enum": [
              4,
              6,
              8
            ]
          },
          "trainingMode": {
            "enum": [
              "CONTINUED_REFERENCE",
              "FRESH_FROM_ZERO"
            ]
          }
        }
      }
    },
    "bestObservedDevModel": {
      "enum": [
        "BASELINE",
        "D4",
        "D6",
        "D8",
        null
      ]
    },
    "workerElapsedSeconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "servedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceReportedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "legacyRunAccepted": {
      "const": false
    },
    "modelAdoption": {
      "const": false
    },
    "generalizationClaim": {
      "const": false
    },
    "DEVReused": {
      "const": true
    },
    "productComparison": {
      "const": "NOT_CONNECTED"
    },
    "freshRoundsCompleted": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 768
    },
    "devRowsProcessed": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 20989927
    },
    "pureDepthContrast": {
      "const": "FRESH_D4_D6_D8_ONLY"
    },
    "continuedBaselineIsNotFreshControl": {
      "const": true
    }
  },
  "x-semanticRules": [
    "Fixed model order BASELINE,D4,D6,D8. Baseline depth 6 is the consumed continued B256 reference, not a fresh fit and not the depth control.",
    "Fresh D6 is the depth control. Pure depth contrast exists only among fresh D4/D6/D8; the continued B256 pair also differs in training path.",
    "producerStatus mirrors the outer receipt.json/failure.json status: FRESH_DEPTH_SWEEP_AND_DEV_VERIFIED_NOT_ADOPTED iff phase COMPLETE, FAILED_PRESERVED_NOT_ACCEPTED iff phase FAILED, null otherwise.",
    "receiptSha256/completeSha256 are raw SHA-256 of outputs/SEAT_DEPTH_SWEEP_002/receipt.json and complete.json; both required and distinct at COMPLETE, both null otherwise.",
    "priorAttempt is a fixed record of SEAT_DEPTH_SWEEP_001: environment stopped before training, 0 fresh fits, no public score, not accepted. It is never merged with SEAT_DEPTH_SWEEP_002 results.",
    "Candidate metrics and gatePassed stay null until outer completion and sealed inventory joins. gatePassed must equal MAE < baseline MAE and RMSE <= baseline RMSE.",
    "bestObservedDevModel at COMPLETE is the minimum (MAE, RMSE, depth) among baseline and gate-passing candidates; exploratory only, DEV reused; produced before H was designated on 2026-10-22; devRows include the days now designated as H; no adoption, no generalization claim.",
    "Candidate observedRounds 0..256 count fresh trees. currentModelRoundsCompleted may reset to 0 or null on candidate transition.",
    "trainingCallsReserved is a reservation count. verifiedCandidateCount is 0 until final acceptance, then 3.",
    "UI derives seat deltas (candidate - reference, seats) and relative improvement ((reference - candidate)/reference*100 %) from sealed metrics only; the producer does not need to emit them.",
    "servedAt must not be more than 10 minutes ahead of the receiver clock; a future-dated file is rejected."
  ]
}
