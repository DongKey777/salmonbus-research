{
  "name": "salmonbus-research-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 62421 --strictPort",
    "build": "tsc -b && vite build",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "build:pages": "tsc -b && vite build --mode pages && node scripts/stage-pages.mjs",
    "snapshots": "node --experimental-strip-types --no-warnings scripts/capture-snapshots.mjs",
    "audit:pages": "node scripts/audit-public.mjs dist-pages --require-sidecar",
    "deploy:pages": "bash scripts/deploy-pages.sh"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "echarts": "6.1.0",
    "react-grid-layout": "2.3.0",
    "@tanstack/react-query": "5.104.4",
    "@tanstack/react-table": "8.21.3",
    "@radix-ui/react-dialog": "1.3.1",
    "lucide-react": "1.59.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "@vitejs/plugin-react": "6.1.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
